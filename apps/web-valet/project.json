{
  "name": "web-valet",
  "root": "apps/web-valet",
  "sourceRoot": "apps/web-valet/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "cd apps/web-valet && yarn build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-valet && yarn dev"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-valet && yarn start"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-valet && yarn lint"
      }
    }
  }
}

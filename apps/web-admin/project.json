{
  "name": "web-admin",
  "root": "apps/web-admin",
  "sourceRoot": "apps/web-admin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "cd apps/web-admin && yarn build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-admin && yarn dev"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-admin && yarn start"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/web-admin && yarn lint"
      }
    }
  }
}
